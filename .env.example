# ============================================================
# App
# ============================================================

# Canonical origin per brand — used for metadata (canonicals, Open Graph),
# sitemap.xml, robots.txt, and the rail's brand switcher. The request's
# host picks the brand (see proxy.ts / lib/brands.ts).
#   personal: defaults to NEXT_PUBLIC_SITE_URL, then http://localhost:3000
#   fst:      defaults to https://fullstacktechnologiesllc.com
NEXT_PUBLIC_PERSONAL_URL=
NEXT_PUBLIC_FST_URL=
# Legacy alias for the personal URL (still honored)
NEXT_PUBLIC_SITE_URL=

# ============================================================
# Email (contact form delivery)
# ============================================================
# RESEND_API_KEY is required to send inquiries. Without it, valid
# requests return 503 and visitors can retry or use the email fallback.
# Message bodies are not logged as a substitute for delivery.

# Get a key at https://resend.com
RESEND_API_KEY=

# Where messages land, per brand (chosen by the host they were sent from);
# both default to nickhowell6425@gmail.com
CONTACT_TO_EMAIL=
CONTACT_TO_EMAIL_FST=

# Must be a verified sender on your Resend account;
# defaults to onboarding@resend.dev
CONTACT_FROM_EMAIL=
